# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.

# Secret — the only value here that must never be logged, traced or committed.
DEEPSEEK_APIKEY=sk-replace-me

# Provider config
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Limits (Session 1 needs the timeouts; the rest arrive with policy.py)
REQUEST_CONNECT_TIMEOUT_S=5
REQUEST_READ_TIMEOUT_S=60
MAX_STEPS=5

# Pricing, USD per 1M tokens. Set from the current price list; nothing is
# hard-coded in code. Cache-hit input is priced lower than cache-miss input,
# which is where an agent loop's cost actually lives.
PRICE_INPUT_CACHE_HIT_PER_M=0.00
PRICE_INPUT_CACHE_MISS_PER_M=0.00
PRICE_OUTPUT_PER_M=0.00
