# Copy to .env and fill in. .env is gitignored; this file holds placeholders only.

# Secret — the only value here that must never be logged, traced or committed.
DEEPSEEK_APIKEY=sk-replace-me

# Provider config
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Which model to talk to. Unset means deepseek, and every DEEPSEEK_* variable
# below keeps working exactly as before.
#   deepseek  hosted, needs a key, costs money
#   ollama    local, no key, free, much slower per call
PROVIDER=deepseek

# Ollama (PROVIDER=ollama). No key needed - the server serves anyone.
# IMPORTANT: ollama defaults to 4096 tokens of context no matter what the
# model supports, and SILENTLY DROPS the oldest messages on overflow, which
# corrupts an agent's tool-call history. Start the server with:
#     OLLAMA_CONTEXT_LENGTH=32768 ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# Limits (Session 1 needs the timeouts; the rest arrive with policy.py).
# Leave REQUEST_READ_TIMEOUT_S unset to get the PROVIDER's own default - 60s
# for deepseek, 600s for ollama. Setting it here applies one number to both,
# and 60s is not enough for a local model: a 9B with thinking enabled took
# 155s for its first call.
REQUEST_CONNECT_TIMEOUT_S=5
# REQUEST_READ_TIMEOUT_S=60

# Run budgets (Session 5). Every one of these is a way the run can stop, and
# each has its own exit code. CLI flags override them.
#   MAX_STEPS         model calls per run
#   MAX_TOOL_CALLS    tool calls per RUN, not per turn - five steps can mean
#                     fifty calls
#   MAX_RUN_SECONDS   wall clock, including time spent inside tools
#   MAX_TOTAL_TOKENS  blank = no token limit
#   MAX_SPEND         USD, estimated. Needs the PRICE_* values below, or the
#                     run is refused rather than silently unlimited
#   TOKEN_RESERVE     held back for the response whose usage is not known yet;
#                     this is the most a budget can be overshot by
MAX_STEPS=5
MAX_TOOL_CALLS=20
MAX_RUN_SECONDS=300
MAX_TOTAL_TOKENS=
MAX_SPEND=
TOKEN_RESERVE=2000

# Session 9. Two different quantities, deliberately not one:
#   MAX_REPEATED_FAILURES  identical calls that FAILED before the run stops.
#                          A model that has not understood the error.
#   MAX_REPEATED_CALLS     identical calls that SUCCEEDED. Higher, because
#                          re-reading a file before reporting on it is
#                          verification - the behaviour the whole project is
#                          trying to produce - and a rule set to 2 bans it.
#                          Blank on either = count but never stop.
#   CONTEXT_WINDOW         tokens the HISTORY must fit in, which is not
#                          MAX_TOTAL_TOKENS: the wallet counts everything the
#                          run ever spent, this counts what travels in the
#                          next request. Blank = use the provider's default
#                          (deepseek 65536, ollama 32768).
MAX_REPEATED_FAILURES=3
MAX_REPEATED_CALLS=5
CONTEXT_WINDOW=

# Session limits (agent/chat.py only - the one-shot CLI ignores these).
# Per-turn limits above still apply to each question INSIDE a session.
#   MAX_SESSION_TOKENS  tokens for the whole conversation. Must be well above
#                       TOKEN_RESERVE or every turn stops before calling out
#   MAX_SESSION_SPEND   USD for the whole conversation; needs PRICE_* below
#   MAX_CONTEXT_TOKENS  ceiling on one prompt; :reset starts a fresh
#                       conversation without ending the session
MAX_SESSION_TOKENS=
MAX_SESSION_SPEND=
MAX_CONTEXT_TOKENS=48000

# Pricing, USD per 1M tokens. Set from the current price list; nothing is
# hard-coded in code. Cache-hit input is priced lower than cache-miss input,
# which is where an agent loop's cost actually lives.
PRICE_INPUT_CACHE_HIT_PER_M=0.00
PRICE_INPUT_CACHE_MISS_PER_M=0.00
PRICE_OUTPUT_PER_M=0.00
