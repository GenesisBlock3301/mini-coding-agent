# Copy to ~/.config/mini-coding-agent/.env (or set MINI_AGENT_CONFIG_FILE).
# Keep this file outside any workspace the agent can read.
PROVIDER=deepseek
DEEPSEEK_APIKEY=
DEEPSEEK_MODEL=deepseek-chat

# For a local Ollama server instead:
# PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.5:9b
# Start the server with OLLAMA_CONTEXT_LENGTH=32768.

# Optional: set a default project directory, or pass --workspace=DIR per run.
# WORKSPACE_DIR=/absolute/path/to/project

MAX_STEPS=5
MAX_TOOL_CALLS=20
MAX_RUN_SECONDS=300
TOKEN_RESERVE=2000
MAX_REPEATED_FAILURES=3
MAX_REPEATED_CALLS=5

# Optional hosted-provider spend limit (USD). Fill in actual provider prices.
# MAX_SPEND=1.00
# PRICE_INPUT_CACHE_HIT_PER_M=
# PRICE_INPUT_CACHE_MISS_PER_M=
# PRICE_OUTPUT_PER_M=
